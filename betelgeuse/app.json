{
  "expo": {
    "name": "Betelgeuse",
    "slug": "betelgeuse",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "scheme": "betelgeuse",
    "orientation": "portrait",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#162E5F"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#162E5F"
      },
      "permissions": [
        "REQUEST_INSTALL_PACKAGES",
        "QUERY_ALL_PACKAGES"
      ],
      "package": "com.slavisa3193.betelgeuse"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
