{
  "expo": {
    "name": "Betelgeuse",
    "slug": "betelgeuse",
    "version": "0.1.0",
    "scheme": "betelgeuse",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "REQUEST_INSTALL_PACKAGES",
        "QUERY_ALL_PACKAGES"
      ],
      "package": "com.slavisa3193.betelgeuse"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
